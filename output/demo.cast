[10.713, "o", "\r\n==================== stage 2/4: four cases (small, large, RGBA, bad params); write then read back, print diffs ====================\r\n"]
[16.719, "o", "== case1: small 7x5 RGB, RLE + uncompressed ==\r\noutput/small_rle.pic: load 7x5 comp=3, differing pixels/bytes=0\r\noutput/small_raw.pic: load 7x5 comp=3, differing pixels/bytes=0\r\n== case2: large 256x192 RGB (long runs/raw spans), RLE ==\r\noutput/big_rle.pic: load 256x192 comp=3, differing pixels/bytes=0\r\n== case3: 7x5 RGBA with alpha, RLE + uncompressed ==\r\noutput/rgba_rle.pic: load 7x5 comp=4, differing pixels/bytes=0\r\noutput/rgba_raw.pic: load 7x5 comp=4, differing pixels/bytes=0\r\n== case4: bad parameters (expect all returns 0) ==\r\nbad comp=0 zero dims=0 null data=0\r\nRESULT: all roundtrips identical\r\n"]
